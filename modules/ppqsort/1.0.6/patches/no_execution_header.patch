parameters.h: drop the unused #include <execution>.

PPQSort defines its own policies in ppqsort::execution and uses nothing from
<execution>. With libstdc++, that header enables the TBB parallel backend
whenever <tbb/tbb.h> happens to be installed on the host, which then fails to
link without -ltbb (undefined tbb::detail::r1::execution_slot).

diff --git a/include/ppqsort/parameters.h b/include/ppqsort/parameters.h
--- a/include/ppqsort/parameters.h
+++ b/include/ppqsort/parameters.h
@@ -1,7 +1,6 @@
 #pragma once
 
 #include <bit>
-#include <execution>
 #include <new>
 
 #ifndef NDEBUG
