profiler/helpers/embed.cpp: include the generated header by file name.

The .hpp is always written next to the .cpp, so the full destination path
(which under Bazel is an output-tree path) need not be on the include path.

diff --git a/profiler/helpers/embed.cpp b/profiler/helpers/embed.cpp
--- a/profiler/helpers/embed.cpp
+++ b/profiler/helpers/embed.cpp
@@ -79,7 +79,14 @@
     FILE* cpp = fopen( ( std::string(destination) + ".cpp" ).c_str(), "wb" );
     fprintf( cpp, "// This file is generated by embed tool, do not modify\n" );
     fprintf( cpp, "// Source: %s\n\n", source );
-    fprintf( cpp, "#include \"%s.hpp\"\n\n", destination );
+    // The .hpp is written next to the .cpp, so include it by file name only;
+    // the full destination path need not be on the include path.
+    const char* destinationName = destination;
+    for( const char* c = destination; *c; c++ )
+    {
+        if( *c == '/' || *c == '\\' ) destinationName = c + 1;
+    }
+    fprintf( cpp, "#include \"%s.hpp\"\n\n", destinationName );
     fprintf( cpp, "namespace Embed\n{\n" );
     fprintf( cpp, "const uint8_t %sData[] =\n", objectName );
     fprintf( cpp, "{\n" );
